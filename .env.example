# Copy this file to .env (which is gitignored). The names match the official TypeSafe SDKs.

TYPESAFE_API_KEY=

# Optional
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_FSD_BBOX=-123.1700,49.2600,-123.1500,49.2700   # W,S,E,N in degrees (default: Kitsilano, Vancouver)
# JEV_FSD_BUDGET_USD=1.00      # stop live model calls (Jev, decision models and LLMs) after this much spend in one
#                              # server run; an endpoint without prices or a reported cost counts as $0, so this cannot stop it
# JEV_FSD_RPM=240              # local cap on live model calls per minute (all of them together)
# JEV_FSD_NPCS=40              # number of traffic cars
# PORT=8322

# Other decision models: endpoints that speak TypeSafe's System One protocol (OpenRouter's Decisions
# API, llama.cpp 0.6.0+, ...). Tested only against a local mock server so far. See docs/agents.md.
# Easiest: Decision ▾ > Connect a decision model in the app; it saves the key here for you. A TypeSafe
# key saved there is TYPESAFE_API_KEY above. By hand: list them in data/decision-endpoints.json.
# JEV_FSD_DECISION_ENDPOINTS=data/decision-endpoints.json   # a different config file

# Your own LLM drivers: endpoints that speak the OpenAI /chat/completions protocol (tested only
# against a local mock server so far, not a real provider). See docs/agents.md.
# Easiest: click LLM next to Rules and Decision in the app; it saves the key here for you.
# Several endpoints: list them in data/llm-endpoints.json and put their keys here, e.g.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=          # also serves OpenRouter's decision models
# One endpoint without a config file (appears as the driver llm:default):
# JEV_FSD_LLM_BASE_URL=http://localhost:11434/v1   # Ollama; OpenAI is https://api.openai.com/v1
# JEV_FSD_LLM_MODEL=llama3.2
# Leave the key unset for local servers that need none.
# JEV_FSD_LLM_API_KEY=
# JEV_FSD_LLM_NAME=default
# JEV_FSD_LLM_PRICE_INPUT_PER_MTOK=0.15             # USD per million tokens; unset = cost unknown ($0),
# JEV_FSD_LLM_PRICE_OUTPUT_PER_MTOK=0.60            #   which JEV_FSD_BUDGET_USD cannot stop
# JEV_FSD_LLM_TIMEOUT_S=10                          # total deadline per decision, retries included
# JEV_FSD_LLM_ENDPOINTS=data/llm-endpoints.json     # a different config file
