# Secrets: the app refuses to write .env unless this line is here.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/

# Saved decision snapshots are local scratch; commit chosen ones on purpose with `git add -f`.
data/snapshots/*.json

# Your LLM endpoints (keys stay in .env; the committed template is data/llm-endpoints.example.json).
data/llm-endpoints.json
# Your decision-model endpoints (template: data/decision-endpoints.example.json).
data/decision-endpoints.json

# Benchmark runs are local results; commit a baseline on purpose with `git add -f`.
data/runs/

# Raw OSM downloads are a local cache. Curated processed map packs are committed.
data/maps/*.osm.xml

# Local scratch
.shots/
.DS_Store
.demo-site/

# Claude Code local settings
.claude/

# Claude Code project notes (local only)
CLAUDE.md
